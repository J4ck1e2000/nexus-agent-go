# Core services
MYSQL_ROOT_PASSWORD=123456
JWT_SECRET=replace-with-a-strong-secret
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# AI model
AI_ENABLED=true
AI_MODE=agent
AI_PROVIDER=qwen
AI_MODEL=qwen3.5-122b-a10b
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-06f22737d58145f19365c8388714a84b

# Knowledge retrieval backend: local | qdrant | auto
KNOWLEDGE_RETRIEVAL_BACKEND=auto
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v3

# Optional: override image sources/proxy in restricted network
GO_BASE_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
RUNTIME_BASE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:latest
GOPROXY=https://goproxy.cn,direct

# Optional: host port mapping (change if local services already occupy defaults)
MYSQL_HOST_PORT=3307
QDRANT_HTTP_HOST_PORT=6335
QDRANT_GRPC_HOST_PORT=6336
