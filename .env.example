# Core services
MYSQL_ROOT_PASSWORD=123456
JWT_SECRET=replace-with-a-strong-secret
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# AI model
AI_ENABLED=true
AI_PROVIDER=qwen
AI_MODEL=qwen3.5-122b-a10b
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-06f22737d58145f19365c8388714a84b

# Knowledge retrieval backend: local | qdrant | auto
KNOWLEDGE_RETRIEVAL_BACKEND=auto
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v3

# Base URL of the required Pi Runtime service
PI_RUNTIME_URL=http://pi-runtime:8010
# Shared secret between gateway and runtime (set a strong value in production)
PI_RUNTIME_TOKEN=replace-with-a-strong-internal-secret
# Gateway-side run limits
PI_RUN_TIMEOUT_SEC=120
PI_TOOL_TIMEOUT_SEC=10
PI_MAX_TOOL_CALLS=12
# Pi Runtime container (reuses AI_BASE_URL / AI_API_KEY / AI_MODEL above)
PI_RUNTIME_PORT=8010
GATEWAY_TOOL_URL=http://gateway:3000

# Agentless SSH Collector
# 1) Set both *_HOST_PATH values to real files on the docker host, e.g.
#      SSH_PRIVATE_KEY_HOST_PATH=/home/user/.ssh/nexus_id_ed25519
#      SSH_KNOWN_HOSTS_HOST_PATH=/home/user/.ssh/known_hosts
# 2) Uncomment the in-container paths below to switch SSH monitoring on.
#    Leaving them empty keeps SSH monitoring disabled (legacy agent only).
SSH_PRIVATE_KEY_HOST_PATH=
SSH_KNOWN_HOSTS_HOST_PATH=
# SSH_PRIVATE_KEY_PATH=/run/secrets/nexus_ssh_key
# SSH_KNOWN_HOSTS_PATH=/app/config/known_hosts
SSH_CONNECT_TIMEOUT_SEC=5
SSH_COMMAND_TIMEOUT_SEC=5
SSH_KEEPALIVE_SEC=15
NODE_POLL_MAX_CONCURRENCY=16

# Optional: override image sources/proxy in restricted network
GO_BASE_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
RUNTIME_BASE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
AGENT_RUNTIME_BASE_IMAGE=docker.m.daocloud.io/nvidia/cuda:12.9.0-base-ubuntu22.04
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:latest
GOPROXY=https://goproxy.cn,direct

# Optional: host port mapping (change if local services already occupy defaults)
MYSQL_HOST_PORT=3307
QDRANT_HTTP_HOST_PORT=6335
QDRANT_GRPC_HOST_PORT=6336
