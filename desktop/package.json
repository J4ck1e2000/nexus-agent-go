{
  "name": "nexus-desktop",
  "productName": "Nexus Desktop",
  "version": "0.1.0",
  "description": "Nexus GPU Cluster desktop client built with Electron, React and TypeScript",
  "main": ".vite/build/main.cjs",
  "private": true,
  "author": {
    "name": "Nexus",
    "email": "nexus@example.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.renderer.config.ts --outDir dist-renderer --emptyOutDir",
    "test": "vitest run",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
