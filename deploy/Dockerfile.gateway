# Build args available to all FROM statements.
ARG GO_BASE_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
ARG RUNTIME_BASE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
ARG GOPROXY=https://goproxy.cn,direct

# Build stage: compile Gateway binary.
FROM ${GO_BASE_IMAGE} AS builder

WORKDIR /src

# Re-declare in stage scope for ENV/RUN usage.
ARG GOPROXY
ENV GOPROXY=${GOPROXY}

# Copy module files first for better cache hit.
COPY go.mod go.sum ./
RUN go mod download

# Build static linux binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/nexus-agent-go-gateway ./cmd/gateway

# Runtime stage.
FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /app

COPY --from=builder /out/nexus-agent-go-gateway /usr/local/bin/nexus-agent-go-gateway
COPY web ./web

EXPOSE 3000

ENV PORT=3000
ENV WEB_DIR=/app/web
ENV CONFIG_FILE=/app/web/config.json

CMD ["nexus-agent-go-gateway"]
