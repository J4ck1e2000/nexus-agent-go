# 构建阶段：使用 Go 官方镜像编译 Agent 二进制。
FROM golang:1.22-alpine AS builder

# 设置构建工作目录。
WORKDIR /src

# 先复制 go.mod 以利用缓存下载依赖。
COPY go.mod ./
RUN go mod download

# 复制项目代码并编译 Linux 静态二进制。
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/nexus-agent-go-agent ./cmd/agent

# 运行阶段：使用更小的基础镜像运行产物。
FROM alpine:3.20
WORKDIR /app

# 拷贝 Agent 可执行文件。
COPY --from=builder /out/nexus-agent-go-agent /usr/local/bin/nexus-agent-go-agent

# 暴露 Agent 默认端口。
EXPOSE 8005

# 设置默认环境变量。
ENV PORT=8005
ENV METRICS_INTERVAL=2s

# 容器启动命令。
CMD ["nexus-agent-go-agent"]
