# Build args available to all FROM statements.
ARG GO_BASE_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
ARG RUNTIME_BASE_IMAGE=docker.m.daocloud.io/nvidia/cuda:12.9.0-base-ubuntu22.04
ARG GOPROXY=https://goproxy.cn,direct

# Build stage: compile Agent binary.
FROM ${GO_BASE_IMAGE} AS builder

WORKDIR /src

# Re-declare in stage scope for ENV/RUN usage.
ARG GOPROXY
ENV GOPROXY=${GOPROXY}

# Copy module files first for better cache hit.
COPY go.mod go.sum ./
RUN go mod download

# Build static linux binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/nexus-agent-go-agent ./cmd/agent

# Runtime stage.
FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /app

COPY --from=builder /out/nexus-agent-go-agent /usr/local/bin/nexus-agent-go-agent

EXPOSE 8005

ENV PORT=8005
ENV METRICS_INTERVAL=2s

CMD ["nexus-agent-go-agent"]
